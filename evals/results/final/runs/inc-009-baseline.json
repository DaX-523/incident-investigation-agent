    "corrective_actions": [
      {
        "rank": 1,
        "category": "mitigate",
        "action": "Restore es-data-3 (or replace it with a new data node) so the two unassigned 'products' primaries can recover. If they cannot recover, restore those shards from the latest snapshot or reindex the affected data. Watch cluster health return to GREEN and unassigned_shards return to 0.",
        "rationale": "The searches fail because two primary shards have no copy. Bringing the shards back is the only full fix for the missing brands.",
        "evidence_ids": [
          "E1",
          "E2",
          "E4",
          "E9"
        ]
      },
      {
        "rank": 2,
        "category": "mitigate",
        "action": "Until the shards recover, have search-svc or the web tier surface a clear 'results may be incomplete' notice on partial_results and return a retryable error rather than an empty result set. Do not roll back web-frontend v12.3.0 for this incident; it is not the cause.",
        "rationale": "Reduces customer-facing harm while the cluster is degraded. The rollback would not restore the missing shards.",
        "evidence_ids": [
          "E3",
          "E7",
          "E9"
        ]
      },
      {
        "rank": 3,
        "category": "fix",
        "action": "Close SRCH-311: set number_of_replicas>=1 on the 'products' index and confirm replicas are allocated across es-data-1..3. Do this once the primaries are assigned.",
        "rationale": "With zero replicas, any single data-node loss makes part of the index unavailable. This is the root-cause gap.",
        "evidence_ids": [
          "E1",
          "E2",
          "E5",
          "E8",
          "E9"
        ]
      },
      {
        "rank": 4,
        "category": "prevent",
        "action": "Add a change-review gate so that any change setting number_of_replicas=0 on a production index needs explicit sign-off and an expiry date. Track any temporary replica removal as a tracked follow-up.",
        "rationale": "The cost-saving change was intended to be temporary but was never reverted, and nothing flagged it.",
        "evidence_ids": [
          "E5",
          "E8"
        ]
      },

          },
          {
            "text": "search-svc WARN at 15:19:02Z: 'partial results: 2 of 10 shards failed (NoShardAvailableActionException) index=products'; ERROR at 15:21:40Z: 'all shards failed for filtered query (brand filter routed to unavailable shards)'.",
            "evidence_ids": [

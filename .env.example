# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # only for INVESTIGATOR_PROVIDER=openai or openai:* role overrides

# Provider: anthropic (default) | openai. A preset picks a size tier per role; the provider fills it:
#   anthropic: small=claude-haiku-5-5, medium=claude-sonnet-5-5, large=claude-opus-5-5
#   openai:    small=gpt-5.4,          medium=o3,                large=o3
INVESTIGATOR_PROVIDER=anthropic
# Model preset: budget (default, cheapest) | balanced | quality
INVESTIGATOR_PRESET=budget
# LLM judge used by evals/compare.py to grade root cause, red herrings, must-not and factors (none = lexical only)
# JUDGE_MODEL=openai:gpt-5.4-mini
# Per-role overrides (any provider), e.g.:
# MODEL_CRITIC=openai:o3
# EFFORT_REASONING=high

# LangSmith tracing (runs, node timings, LLM + tool calls). Studio itself only needs a browser login.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=incident-investigator
